DJANGO_SECRET_KEY=change-this-in-production-use-a-long-random-key
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Leave DB_* unset to use SQLite locally.
# For PostgreSQL, set all of these:
# DB_NAME=autoledger
# DB_USER=autoledger
# DB_PASSWORD=choose-a-strong-password
# DB_HOST=localhost
# DB_PORT=5432
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.com
# Web Push: generate signing files with `python manage.py setup_webpush`.
# In production, preserve the keys and set a real contact email below.
WEBPUSH_SUBJECT=mailto:admin@example.com
# WEBPUSH_PRIVATE_KEY=/path/to/webpush-private.pem
# WEBPUSH_PUBLIC_KEY=your-base64url-public-key
# Railway production (attach a volume at /data):
# DJANGO_DEBUG=0
# DJANGO_MEDIA_ROOT=/data/media
# WEBPUSH_KEYS_DIR=/data/webpush
# PORT=8000
# WEB_CONCURRENCY=2
